{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ModelObject",
  "title": "ModelObject",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Model identifier"
    },
    "object": {
      "type": "string",
      "enum": [
        "model"
      ]
    },
    "created": {
      "type": "integer"
    },
    "owned_by": {
      "type": "string",
      "description": "Model provider (e.g., openai, anthropic, google)"
    }
  }
}