{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ImageGenerationRequest",
  "title": "ImageGenerationRequest",
  "type": "object",
  "required": [
    "prompt",
    "model"
  ],
  "properties": {
    "model": {
      "type": "string",
      "description": "Image generation model identifier"
    },
    "prompt": {
      "type": "string",
      "description": "Text description of the image to generate"
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 1
    },
    "size": {
      "type": "string",
      "enum": [
        "256x256",
        "512x512",
        "1024x1024",
        "1792x1024",
        "1024x1792"
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "standard",
        "hd"
      ]
    },
    "response_format": {
      "type": "string",
      "enum": [
        "url",
        "b64_json"
      ]
    }
  }
}