{
  "opencollection": "1.0.0",
  "info": {
    "name": "TrueFoundry AI Gateway Audio Models API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.truefoundry.com/api/llm/models"
          },
          "docs": "Returns a list of available models accessible through the gateway."
        }
      ]
    }
  ],
  "bundled": true
}